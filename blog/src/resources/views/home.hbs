<section id="carousel">
    <div class="container">
        <div class="row ">
            <div class="col-md-6 d-flex align-items-center">
                <div>
                    <h1>CyberPhone</h1>
                    <h3>Best Smartphone of 2021!</h3>
                    <p>Cras tortor mi, lobortis quis ornare in, varius scelerisque urna. Vivamus imperdiet dolor nec
                        odio convallis consequat.</p>
                    <div>
                        <button class="btn btn-white mr-2">More Info</button>
                        <button class="btn btn-blue" id="showCartBtn" data-toggle="modal" data-target="#myModal">
                            <i class="fa fa-shopping-cart"></i>
                            <p id="numCartItem"></p>
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mt-5">
                <img class="img-fluid" src="./image/product-header2.png" alt="">
            </div>
        </div>
    </div>
</section>

<section class="products section">
    <h2 class="section-title" style="text-align: center; margin-bottom: 30px;">-Top Premium Products-</h2>

    <style>
        /* CSS hỗ trợ Slick Slider để các card luôn cao bằng nhau */
        .slick-track {
            display: flex !important;
            align-items: stretch !important;
        }
        .slick-slide {
            height: auto !important;
            display: flex !important;
            justify-content: center;
        }
        /* Style cho các nút điều hướng của Slick (tùy chọn) */
        .slick-dots {
            bottom: -35px;
        }
        .slick-prev:before, .slick-next:before {
            color: #333; /* Đổi màu mũi tên nếu cần */
        }
    </style>

    <div class="products__content container-fluid">
        <!-- class 'your-class' là nơi Slick sẽ khởi tạo -->
        <div class="your-class" id="phoneList" style="margin: 0 -10px;">
            {{#each newProducts}}
            <div class="item-product" style="padding: 10px; outline: none;">
                <div class="card cardPhone" style="display: flex; flex-direction: column; width: 100%; height: 100%; border: 1px solid #ececec; border-radius: 12px; overflow: hidden; background: #fff; box-shadow: 0 4px 15px rgba(0,0,0,0.05); transition: transform 0.3s ease;">
                    
                    <!-- Ảnh sản phẩm -->
                    <div style="width: 100%; height: 200px; background: #f9f9f9; display: flex; align-items: center; justify-content: center; padding: 20px;">
                        <img src="{{this.img}}" alt="{{this.name}}" style="max-width: 100%; max-height: 100%; object-fit: contain;">
                    </div>
                    
                    <!-- Nội dung Card -->
                    <div class="card-body" style="display: flex; flex-direction: column; flex: 1; padding: 20px;">
                        <div style="margin-bottom: 12px;">
                            <!-- Tên sản phẩm: Giới hạn đúng 1 dòng, tràn sẽ hiện '...' -->
                            <h3 style="display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; min-height: 1.4em; font-size: 1.1rem; font-weight: 700; margin: 0; color: #2c3e50;">
                                {{this.name}}
                            </h3>
                            <!-- Giá sản phẩm -->
                            <p style="color: #e74c3c; font-size: 1.25rem; font-weight: 800; margin: 8px 0 0 0;">
                                {{this.price}}
                            </p>
                        </div>

                        <!-- Mô tả sản phẩm: Giới hạn đúng 3 dòng để card luôn đều nhau -->
                        <p style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; min-height: 4.5em; font-size: 0.9rem; color: #7f8c8d; line-height: 1.5em; margin-bottom: 20px;">
                            {{this.desc}}
                        </p>

                        <!-- Phần nút bấm: Luôn nằm dưới cùng nhờ margin-top: auto -->
                        <div style="margin-top: auto; display: flex; justify-content: space-between; align-items: center; border-top: 1px solid #f1f1f1; pt: 15px; padding-top: 15px;">
                            <div class="cardPhone__detail">
                                <button class="open-detail" onclick="open_d('{{this.slug}}')" style="background: none; border: none; color: #3498db; cursor: pointer; padding: 0; font-size: 0.85rem; font-weight: 600; font-style: italic;">
                                    Show detail >>
                                </button>
                            </div>
                            <div>
                                <button class="btnPhone-shadow" onclick="addAction('{{this.slug}}')" style="padding: 8px 16px; background: #27ae60; color: white; border: none; border-radius: 6px; cursor: pointer; font-size: 0.85rem; font-weight: 700; box-shadow: 0 2px 8px rgba(39, 174, 96, 0.3);">
                                    <i class="fa fa-shopping-cart" style="margin-right: 5px;"></i> Buy Now
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</section>

<script src="./js/slickActive.js"></script>
<script>
    checkPathToActive('{{pathname}}');
    document.addEventListener('DOMContentLoaded', function () {
         call_slick();
    })
</script>