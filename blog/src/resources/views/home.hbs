<section id="carousel">
    <div class="container">
        <div class="row ">
            <div class="col-md-6 d-flex align-items-center">
                <div>
                    <h1>CyberPhone</h1>
                    <h3>Best Smartphone of 2021!</h3>
                    <p>Cras tortor mi, lobortis quis ornare in, varius scelerisque urna. Vivamus imperdiet dolor nec
                        odio convallis consequat.</p>
                    <div>
                        <button class="btn btn-white mr-2">More Info</button>
                        <button class="btn btn-blue" id="showCartBtn" data-toggle="modal" data-target="#myModal">
                            <i class="fa fa-shopping-cart"></i>
                            <p id="numCartItem"></p>
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mt-5">
                <img class="img-fluid" src="./image/product-header2.png" alt="">
            </div>
        </div>
    </div>
</section>

<section class="products section">
    <h2 class="section-title">-New Products-</h2>
    <div id="filter" class="customed-select mb-5" style="display:none">
        <select id="myOptions" onchange="getListPhones()">
            <option value="none" selected>Choose your product</option>
            <option value="Phone">Phone</option>
            <option value="Accessory">Accessory</option>
        </select>
    </div>

    {{!-- CSS này xử lý việc chỉ hiện 5 item và chống tràn text --}}
    <style>
        /* Chỉ hiển thị 5 item đầu tiên */
        #phoneList .item-product:nth-child(n+6) {
            display: none !important;
        }

        /* Chống tràn text và giữ các card bằng nhau */
        .card-title-limit {
            display: -webkit-box;
            -webkit-line-clamp: 1;
            -webkit-box-orient: vertical;
            overflow: hidden;
            min-height: 1.5em;
        }

        .card-text-limit {
            display: -webkit-box;
            -webkit-line-clamp: 3;
            -webkit-box-orient: vertical;
            overflow: hidden;
            min-height: 4.5em; /* Đảm bảo bằng 3 dòng text */
        }
    </style>

    <div class="products__content container-fluid">
        <div class="your-class row" id="phoneList" style="display: flex; flex-wrap: wrap; margin: 0 -15px;">
            {{#each products}}
            <div class="item-product col-md-4 col-sm-6" style="padding: 15px; display: flex;">
                <div class="card cardPhone" style="display: flex; flex-direction: column; width: 100%; border: 1px solid #ddd; border-radius: 8px; overflow: hidden; background: #fff;">
                    
                    <img src="{{this.img}}" alt="..." style="width: 100%; height: 200px; object-fit: contain; background: #f8f8f8; padding: 10px;">
                    
                    <div class="card-body" style="display: flex; flex-direction: column; flex: 1; padding: 15px;">
                        <div style="margin-bottom: 10px;">
                            <h3 class="card-title-limit" style="font-size: 1.1rem; font-weight: bold; margin: 0;">
                                {{this.name}}
                            </h3>
                            <h3 style="color: #e74c3c; font-size: 1.2rem; font-weight: bold; margin: 5px 0;">
                                {{this.price}}
                            </h3>
                        </div>

                        <p class="card-text-limit" style="font-size: 0.9rem; color: #666; margin-bottom: 15px; line-height: 1.5em;">
                            {{this.desc}}
                        </p>

                        <div style="margin-top: auto; display: flex; justify-content: space-between; align-items: center;">
                            <div class="cardPhone__detail">
                                <button class="open-detail" onclick="open_d('{{this.slug}}')" style="background: none; border: none; color: #007bff; cursor: pointer; padding: 0; font-size: 0.85rem;">
                                    <i>Show detail >></i>
                                </button>
                            </div>
                            <button class="btnPhone-shadow" onclick="addAction('{{this.slug}}')" style="padding: 8px 12px; background: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer; font-size: 0.85rem; font-weight: bold;">
                                <i class="fa fa-shopping-cart"></i> Buy Now
                            </button>
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</section>

<script src="./js/slickActive.js"></script>
<script>
    checkPathToActive('{{pathname}}');
    document.addEventListener('DOMContentLoaded', function () {
         call_slick();
    })
</script>