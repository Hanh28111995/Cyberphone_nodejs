<section id="carousel">
    <div class="container">
        <div class="row ">
            <div class="col-md-6 d-flex align-items-center">
                <div>
                    <h1>CyberPhone</h1>
                    <h3>Best Smartphone of 2021!</h3>
                    <p>Cras tortor mi, lobortis quis ornare in, varius scelerisque urna. Vivamus imperdiet dolor nec
                        odio convallis consequat.</p>
                    <div>
                        <button class="btn btn-white mr-2">More Info</button>
                        <button class="btn btn-blue" id="showCartBtn" data-toggle="modal" data-target="#myModal">
                            <i class="fa fa-shopping-cart"></i>
                            <p id="numCartItem"></p>
                        </button>
                    </div>
                </div>
            </div>
            <div class="col-md-6 mt-5">
                <img class="img-fluid" src="./image/product-header2.png" alt="">
            </div>
        </div>
    </div>
</section>

<section class="products section">
    <h2 class="section-title">-New Products-</h2>
    <div id="filter" class="customed-select mb-5" style="display:none">
        <select id="myOptions" onchange="getListPhones()">
            <option value="none" selected>Choose your product</option>
            <option value="Phone">Phone</option>
            <option value="Accessory">Accessory</option>
        </select>
    </div>
    <div class="products__content container-fluid">
        <div class="your-class row" id="phoneList" style="display: flex; flex-wrap: wrap; margin-right: -15px; margin-left: -15px;">
            {{#each products}}
            {{!-- Kiểm tra nếu index nằm trong khoảng 0-4 (lấy 5 sản phẩm đầu) --}}
            {{#if @first}} {{!-- Đây là một cách đánh dấu nếu bạn muốn xử lý đặc biệt cho item đầu, nhưng để lấy đúng 5 cái mà không có helper so sánh, ta nên dùng CSS để ẩn từ cái thứ 6 hoặc dùng logic dưới đây --}}
            {{/if}}

            <div class="item-product col-md-4 col-sm-6" 
                 style="display: {{#if @index}} {{#if (gt @index 4)}}none{{else}}flex{{/if}} {{else}}flex{{/if}}; flex-direction: column; margin-bottom: 30px; padding-right: 15px; padding-left: 15px; flex: 0 0 33.333%; max-width: 33.333%;">
                
                {{!-- Lưu ý: Nếu môi trường của bạn cực kỳ khắt khe không cho dùng helper 'gt', hãy xóa dòng style display ở trên và dùng CSS bên ngoài: .item-product:nth-child(n+6) { display: none; } --}}

                <div class="card cardPhone" style="display: flex; flex-direction: column; height: 100%; border: 1px solid #ddd; border-radius: 8px; overflow: hidden; width: 100%;">
                    <img src="{{this.img}}" alt="..." style="width: 100%; height: 200px; object-fit: contain; background: #f8f8f8; border-bottom: 1px solid #eee;">
                    
                    <div class="card-body" style="display: flex; flex-direction: column; flex-grow: 1; padding: 15px;">
                        <div style="display: flex; flex-direction: column; margin-bottom: 10px;">
                            <h3 class="cardPhone__title" style="display: -webkit-box; -webkit-line-clamp: 1; -webkit-box-orient: vertical; overflow: hidden; font-size: 1.1rem; font-weight: bold; min-height: 1.5em; margin: 0 0 5px 0; line-height: 1.5em;">
                                {{this.name}}
                            </h3>
                            <h3 style="color: #e74c3c; font-size: 1.2rem; font-weight: bold; margin: 0;">{{this.price}}</h3>
                        </div>

                        <p class="cardPhone__text" style="display: -webkit-box; -webkit-line-clamp: 3; -webkit-box-orient: vertical; overflow: hidden; min-height: 4.5em; font-size: 0.9rem; color: #666; margin-bottom: 15px; line-height: 1.5em;">
                            {{this.desc}}
                        </p>

                        <div style="margin-top: auto;">
                            <div style="display: flex; justify-content: space-between; align-items: center;">
                                <div class="cardPhone__detail">
                                    <button class="open-detail" onclick="open_d('{{this.slug}}')" style="background: none; border: none; color: #007bff; cursor: pointer; padding: 0; font-size: 0.85rem; font-style: italic;">
                                        Show detail &gt;&gt;
                                    </button>
                                    <div id="inner_detail" class="inner_detail" style="display: none;">
                                        <!-- Table detail hidden by default -->
                                    </div>
                                </div>
                                <button class="btnPhone-shadow" onclick="addAction('{{this.slug}}')" style="padding: 8px 15px; background: #28a745; color: white; border: none; border-radius: 4px; cursor: pointer; font-weight: bold; font-size: 0.9rem;">
                                    <i class="fa fa-shopping-cart"></i> Buy Now
                                </button>
                            </div>
                        </div>
                    </div>
                </div>
            </div>
            {{/each}}
        </div>
    </div>
</section>

<script src="./js/slickActive.js"></script>
<script>
    checkPathToActive('{{pathname}}');
    document.addEventListener('DOMContentLoaded', function () {
         call_slick();
    })
</script>