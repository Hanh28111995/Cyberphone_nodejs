<div class="container mt-5 mb-5" style="padding-top: 120px;">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2 class="mb-0">Blog</h2>
        <a href="/blog" class="btn btn-outline-secondary">Refresh</a>
    </div>

    <div class="row">
        {{#each posts}}
        <div class="col-md-6 mb-4">
            <div class="card h-100 shadow-sm">
                {{#if this.image}}
                <a href="/blog/{{this.slug}}">
                    <img src="{{this.image}}" class="card-img-top" alt="{{this.title}}" style="height: 220px; object-fit: cover;">
                </a>
                {{/if}}
                <div class="card-body d-flex flex-column">
                    <h5 class="card-title" style="min-height: 48px;">
                        <a href="/blog/{{this.slug}}" style="text-decoration: none; color: inherit;">{{this.title}}</a>
                    </h5>
                    <p class="card-text text-muted" style="flex: 1;">{{this.excerpt}}</p>
                    <div class="d-flex justify-content-between align-items-center">
                        <small class="text-muted">{{this.publishedAt}}</small>
                        <a class="btn btn-sm btn-primary" href="/blog/{{this.slug}}">Xem</a>
                    </div>
                </div>
            </div>
        </div>
        {{/each}}
    </div>

    <div class="pagination pagination-centered mx-auto">
      <ul class="pagination mt-4">
        {{#paginate pagination type="first"}}
          <li {{#if disabled}}class="disabled page-item"{{/if}}><a class="page-link" href="?p={{n}}">First</a></li>
        {{/paginate}}
        {{#paginate pagination type="previous"}}
          <li {{#if disabled}}class="disabled page-item"{{/if}}><a class="page-link" href="?p={{n}}">Prev</a></li>
        {{/paginate}}
        {{#paginate pagination type="middle" limit="5"}}
          <li {{#if active}}class="active page-item"{{/if}}><a class="page-link" href="?p={{n}}">{{n}}</a></li>
        {{/paginate}}
        {{#paginate pagination type="next"}}
          <li {{#if disabled}}class="disabled page-item"{{/if}}><a class="page-link" href="?p={{n}}">Next</a></li>
        {{/paginate}}
        {{#paginate pagination type="last"}}
          <li {{#if disabled}}class="disabled page-item"{{/if}}><a class="page-link" href="?p={{n}}">Last</a></li>
        {{/paginate}}
      </ul>
    </div>
</div>

<script>
    checkPathToActive('{{pathname}}');
</script>
