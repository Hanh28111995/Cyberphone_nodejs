<div class="Ads-banner container px-0">
    <div class="row mb-5">
        <div class="banner-left col-8">
            <img id="img" class="img-fluid" onclick="changeImage()" src="./img/phone/banner/banner-left/3.png" alt="">
            <script>
                var index = 1;
                changeImage = function () {
                    var imgs = ["./img/phone/banner/banner-left/1.png", "./img/phone/banner/banner-left/2.png",
                        "./img/phone/banner/banner-left/3.png", "./img/phone/banner/banner-left/4.png"]
                    document.getElementById('img').src = imgs[index];
                    index++;
                    if (index == 4) {
                        index = 0;
                    }
                }
                setInterval(changeImage, 1500);
            </script>
        </div>
        <div class="banner-right col-4">
            <div class="banner-right-top">
                <img class="img-fluid" src="./img/phone/banner/banner-right/euro-m51-390-97-390x97.png" alt="">
            </div>
            <div class="banner-right-bottom">
                <img class="img-fluid" src="./img/phone/banner/banner-right/sticky-A15-15s-390-97-390x97.png" alt="">
            </div>
        </div>
    </div>
</div>

<form method="GET" action="" name="phone-filter-form">
    <div style="display: none;">
        <div class="form-group">
            <input type="text" name="type" value="" class="form-control" id="type-phone-input">
        </div>
        <button type="submit" class="btn btn-primary">Add</button>
    </div>
</form>

<div id="filter-1" class="container d-flex justify-content-center">
</div>

<div class="PList container">
    <div class="box-common__main row ">
        {{#each products}}
        <div class="listproduct col-md-4 col-sm-4 col-xs-4 card my-2 py-5 " style="align-items: center">
            <div class="listproduct1 text-center">
                <a href="/phone-list/{{this.slug}}" style="text-decoration: none; color: inherit;">
                    <img class="img-fluid" src="{{this.img}}" alt="{{this.name}}" loading="lazy" decoding="async">
                    <h5 style="margin-top: 15px; font-weight: bold;">{{this.name}}</h5>
                </a>
                <h5 style="margin-top: 6px;">Online giá rẻ</h5>
                <strong class="text-danger" style="font-size: 1.2rem;">{{this.price}}</strong>
                <h5 style="font-size: 15px;text-decoration: line-through; color: #888;">20.990.000₫
                    <span style="display: inline-block; color: red;"> -28%</span>
                </h5>
            </div>
        </div>
        {{/each}}
    </div>
</div>
<div class="pagination pagination-centered mx-auto">
  <ul class="pagination mt-5">
    {{#paginate pagination type="first"}}
      <li {{#if disabled}}class="disabled page-item"{{/if}}><a class="page-link" href="?p={{n}}">First</a></li>
    {{/paginate}}
    {{#paginate pagination type="previous"}}
      <li {{#if disabled}}class="disabled page-item"{{/if}}><a class="page-link" href="?p={{n}}">Prev</a></li>
    {{/paginate}}
    {{#paginate pagination type="middle" limit="5"}}
      <li {{#if active}}class="active page-item"{{/if}}><a class="page-link" href="?p={{n}}">{{n}}</a></li>
    {{/paginate}}
    {{#paginate pagination type="next"}}
      <li {{#if disabled}}class="disabled page-item"{{/if}}><a class="page-link" href="?p={{n}}">Next</a></li>
    {{/paginate}}
    {{#paginate pagination type="last"}}
      <li {{#if disabled}}class="disabled page-item"{{/if}}><a class="page-link" href="?p={{n}}">Last</a></li>
    {{/paginate}}
  </ul>
</div>

<script>
    let filterArr2 = {{{ json  typeList }}}
    function renderList(arr) {
        let content = "";
        arr.forEach(function (item) {
            let btnContent = "";
            if (item === 'Others') {
                btnContent = `<div style="width: 120px; height: 35px; line-height: 35px; text-align: center; font-weight: bold; font-size: 16px; color: #333;">Khác</div>`;
            } else {
                btnContent = `<img class="img-fluid" src="./img/phone/phanloai/${item}.jpg" alt="${item}" style="max-height: 35px;">`;
            }
            
            content += `  
            <a href="" id="${item}BTN" class="btn-phanloai mx-2" data-id="${item}" style="text-decoration: none;">
               <button class="btn btn-phanloai-child" style="border: 2px solid transparent; border-radius: 8px; padding: 5px 15px; background-color: transparent; transition: all 0.3s ease;">
               ${btnContent}
               </button>
            </a>
                   `
        })
        document.getElementById("filter-1").innerHTML = content;
    }
    renderList(filterArr2);

    checkPathToActive('{{pathname}}');
    document.addEventListener('DOMContentLoaded', function () {
        let currentFilter = '{{{ response }}}';

        // Khôi phục trạng thái border của nút đang được chọn từ URL (chỉ 1 nút duy nhất)
        if (currentFilter && currentFilter !== '') {
            $("#" + currentFilter + "BTN .btn-phanloai-child").css("border-color", "#007bff");
            $("#type-phone-input").val(currentFilter);
        }

        for (let i = 0; i < filterArr2.length; i++) {
            $("#" + filterArr2[i] + "BTN").click(function (e) {
                e.preventDefault();
                let clickedId = $(this).attr("data-id");
                let colorCheck = $("#" + clickedId + "BTN .btn-phanloai-child");
                
                // Lấy ra trạng thái viền hiện tại của nút vừa click
                let currentBorderColor = colorCheck.css("border-color");
                
                // Reset viền của tất cả các nút về transparent
                $(".btn-phanloai-child").css("border-color", "transparent");
                
                // Nếu viền cũ là trong suốt (chưa chọn) -> Bật nó lên
                if (currentBorderColor === "rgba(0, 0, 0, 0)" || currentBorderColor === "transparent" || currentBorderColor === "rgb(0, 0, 0)") {
                    colorCheck.css("border-color", "#007bff");
                    currentFilter = clickedId;
                    $("#type-phone-input").val(currentFilter);
                }
                // Nếu viền cũ đang bật (đã chọn) -> Tắt nó đi (hủy lọc)
                else {
                    currentFilter = '';
                    $("#type-phone-input").val('');
                }
            
            // Thay vì FilterForm.submit() gây tải lại toàn bộ trang,
            // chúng ta dùng AJAX (fetch) để chỉ re-render danh sách sản phẩm
            let typeInput = $("#type-phone-input").val();
            let url = window.location.pathname + "?type=" + typeInput;
            
            // Đổi URL trên trình duyệt
            window.history.pushState({}, '', url);

            // Fetch dữ liệu HTML mới và cập nhật DOM
            fetch(url)
                .then(response => response.text())
                .then(html => {
                    const parser = new DOMParser();
                    const doc = parser.parseFromString(html, 'text/html');
                    
                    // Lấy ra phần HTML chứa sản phẩm và phân trang mới
                    const newPList = doc.querySelector('.PList').innerHTML;
                    const newPagination = doc.querySelector('.pagination-centered').innerHTML;
                    
                    // Re-render (cập nhật) lại phần hiển thị trên trang
                    document.querySelector('.PList').innerHTML = newPList;
                    document.querySelector('.pagination-centered').innerHTML = newPagination;
                })
                .catch(error => console.error('Lỗi khi lọc sản phẩm:', error));
        });
    }
    })
</script>